map $http_upgrade $syncroom_connection_upgrade {
  default upgrade;
  '' close;
}

log_format syncroom_cache 'syncroom_cache status=$upstream_cache_status bytes=$body_bytes_sent request_time=$request_time';

proxy_cache_path /var/cache/nginx/syncroom-proxy-segment
  levels=1:2
  keys_zone=syncroom_proxy_segment:64m
  max_size=${SYNCROOM_NGINX_CACHE_MAX_SIZE}
  inactive=${SYNCROOM_NGINX_CACHE_INACTIVE}
  use_temp_path=off;

server {
  listen ${SYNCROOM_HTTP_PORT};
  listen [::]:${SYNCROOM_HTTP_PORT};
  server_name _;

  access_log /dev/stdout;
  error_log /dev/stderr warn;

  location = /syncroom-ws {
    proxy_pass http://127.0.0.1:${PORT};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $syncroom_connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location ^~ /api/ {
    proxy_pass http://127.0.0.1:${PORT};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ^~ /proxy/segment/ {
    proxy_buffering on;
    proxy_http_version 1.1;
    proxy_set_header Accept-Encoding "";
    slice ${SYNCROOM_NGINX_SLICE_SIZE};
    proxy_cache syncroom_proxy_segment;
    proxy_cache_key "$scheme$request_method$host$request_uri$slice_range";
    proxy_cache_valid 200 206 ${SYNCROOM_NGINX_CACHE_VALID};
    proxy_cache_lock on;
    proxy_cache_lock_timeout ${SYNCROOM_NGINX_CACHE_LOCK_TIMEOUT};
    proxy_cache_lock_age ${SYNCROOM_NGINX_CACHE_LOCK_AGE};
    proxy_ignore_headers Cache-Control Expires Set-Cookie;
    proxy_hide_header Set-Cookie;
    proxy_set_header Range $slice_range;
    proxy_pass http://127.0.0.1:${PORT};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header X-SyncRoom-Proxy-Cache $upstream_cache_status always;
    add_header X-SyncRoom-Cache $upstream_cache_status always;
    access_log /dev/stdout syncroom_cache;
    access_log syslog:server=127.0.0.1:${NGINX_CACHE_METRICS_PORT},facility=local7,tag=syncroom_cache,nohostname syncroom_cache;
  }

  location ^~ /proxy/ {
    proxy_pass http://127.0.0.1:${PORT};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /livekit {
    return 308 /livekit/;
  }

  location ^~ /livekit/ {
    proxy_pass http://127.0.0.1:${LIVEKIT_PORT}/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $syncroom_connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location = /room {
    return 301 /room/;
  }

  location ^~ /room/ {
    alias /opt/syncroom/apps/web-room/dist/;
    try_files $uri $uri/ /room/index.html;
  }

  location /site/ {
    root /opt/syncroom/apps/web-room/dist;
    try_files $uri =404;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000, immutable";
  }

  location / {
    proxy_pass http://127.0.0.1:${PORT};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $syncroom_connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location ~ /\. {
    deny all;
  }
}
